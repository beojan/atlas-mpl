patch.linewidth: 0.5
patch.facecolor: 348ABD  # blue
patch.edgecolor: EEEEEE
patch.antialiased: True

font.size: 16.0
font.family: sans-serif
font.sans-serif: Atkinson Hyperlegible, TeX Gyre Heros, Helvetica Neue, Helvetica, Free Sans, Nimbus Sans L, Arial, DejaVu Sans
font.serif: TeX Gyre Pagella, Palatino, Palatino Linotype, URW Palladio L, DejaVu Sans
font.monospace: Source Code Pro, Inconsolata, Monaco, Consolas, Ubuntu Mono, DejaVu Sans Mono

text.color: 000000
mathtext.fontset: stixsans
mathtext.default: regular

axes.facecolor: E5E5E5
axes.edgecolor: 000000
axes.linewidth: 1
axes.grid: True
axes.titlesize: 20
axes.labelsize: 18
axes.labelcolor: 000000
axes.axisbelow: False       # grid/ticks are below elements (e.g., lines, text)
axes.formatter.limits: -2, 4
axes.formatter.use_mathtext: True

# Petroff color cycle
axes.prop_cycle: cycler('color', ['3F90DA', 'FFA90E', 'BD1F01', '94A4A2', '832DB6', 'A96B59', 'E76300', 'B9AC70', '717581', '92DADD'])

xtick.color: 000000
xtick.major.size: 0
xtick.direction: in

ytick.color: 000000
ytick.major.size: 0
ytick.direction: in

grid.color: FFFFFF
grid.linestyle: -    # solid line

figure.figsize: 7.1, 4.8
figure.dpi: 150
figure.facecolor: EEEEEE
figure.edgecolor: 0.50

savefig.facecolor: EEEEEE00

